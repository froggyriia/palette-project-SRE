        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (version) (rate(http_requests_total{namespace=\"deploy-demo\", app=\"palette-backend\", handler=\"/version\"}[1m]))",
          "legendFormat": "{{version}}",
          "refId": "A",
          "range": true
        }
      ]
