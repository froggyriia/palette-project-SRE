          },
          "expr": "(sum by (version) (rate(http_requests_total{namespace=\"deploy-demo\", app=\"palette-backend\", status=~\"5..\"}[1m])) or sum by (version) (rate(http_requests_total{namespace=\"deploy-demo\", app=\"palette-backend\"}[1m])) * 0) / sum by (version) (rate(http_requests_total{namespace=\"deploy-demo\", app=\"palette-backend\"}[1m]))",
